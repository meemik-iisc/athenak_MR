# Athena++ (Kokkos version) input file for spherical blast problem

<comment>
problem   = Spherical Bondi Accretion
reference = (arXiv:2512.04166) JWST Confirmation of a Runaway Supermassive Black Hole via its Supersonic Bow Shock

<job>
basename  = cbox                # problem ID: basename of output filenames

<mesh>
nghost    = 4                   # Number of ghost cells
nx1       = 64                  # Number of zones in X1-direction
x1min     = -4.0                # minimum value of X1
x1max     = 4.0                 # maximum value of X1
ix1_bc    = outflow             # inner-X1 boundary flag
ox1_bc    = outflow             # outer-X1 boundary flag

nx2       = 64                  # Number of zones in X2-direction
x2min     = -4.0                # minimum value of X2
x2max     = 4.0                 # maximum value of X2
ix2_bc    = outflow             # inner-X2 boundary flag
ox2_bc    = outflow             # outer-X2 boundary flag

nx3       = 64                  # Number of zones in X3-direction
x3min     = -4.0                # minimum value of X3
x3max     = 4.0                 # maximum value of X3
ix3_bc    = outflow             # inner-X3 boundary flag
ox3_bc    = outflow             # outer-X3 boundary flag

<meshblock>
nx1       = 64                  # Number of cells in each MeshBlock, X1-dir(1)
nx2       = 64                  # Number of cells in each MeshBlock, X2-dir(1)
nx3       = 64                  # Number of cells in each MeshBlock, X3-dir(1)





<time>
evolution  = dynamic            # dynamic/kinematic/static
integrator = rk2                # time integration algorithm
cfl_number = 0.3                # The Courant, Friedrichs, & Lewy (CFL) Number
nlim       = -1                 # cycle limit
tlim       = 20.0               # time limit(0.2 Myr)
ndiag      = 1000             # cycles between diagostic output

<hydro>
eos         = ideal             # EOS type
reconstruct = plm               # spatial reconstruction method
rsolver     = hlle               # Riemann-solver to be used
nscalars    = 1                 # number of passive scalars in hydro
gamma       = 1.666666666667    # gamma = C_p/C_v
fofc        = true
pfloor      = 1.0e-20    # catches negative pressure from flux errors in ConsToPrim
tfloor      = 0.00592    # catches T < 1e4 K from flux errors in ConsToPrim


<hydro_srcterms>
ism_cooling      = true
cool_table       = true    # tabulated float Lambda(T) (false = analytic ISMCoolFn)
hrate            = 0.0
cooling_subcycle = true    # operator-split cooling, sub-cycled after the hydro step
cool_cfl         = 0.1     # each cooling sub-step <= cool_cfl * t_cool_min
cool_nsub_max    = 500     # max sub-steps per hydro step; also caps dt


<units>
length_cgs  = 3.086e+18         # 1 pc  'L0'
mass_cgs    = 4.907e+31         # 1 (pc^3)*(1mp/cm^3)   'L0^3*rho0'
time_cgs    = 3.086e+11         # 1e-2 Myr; v0 = 100 km/s

<problem>
user_srcs   = False             #Set to True to enable User Source Terms
n_amb       = 0.1               #cm^-3
T_amb       = 1e6               #K
n_clump     = 100               #cm^-3
T_clump     = 1e4               #K


<output1>
file_type   = hst               # History data dump
dt          = 1.0            # time increment between outputs

<output2>
file_type   = bin               # Binary data dump
variable    = hydro_w           # variables to be output
dt          = 1.0             # time increment between outputs (10 output files)
