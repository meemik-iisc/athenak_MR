# AthenaK input file for turb_tcgm (3D Cartesian port of Idefix problems/turb_tcgm)

<comment>
problem   = Runaway BH through a time-dependent turbulent CGM, sub-cycled cooling
reference = (arXiv:2512.04166) JWST Confirmation of a Runaway Supermassive Black Hole via its Supersonic Bow Shock

<job>
basename  = turb_tcgm           # problem ID: basename of output filenames

# BH frame: BH at the origin, CGM flows in through the outer-x1 face at -v_bh.
# Idefix z in [-60, 4] -> x1; Idefix R in [0, 2] -> x2, x3 in [-2, 2]. dx = 31.25 pc.
<mesh>
nghost    = 4                   # Number of ghost cells
nx1       = 2048                # Number of zones in X1-direction (flow axis)
x1min     = -60.0               # minimum value of X1 (kpc)
x1max     = 4.0                 # maximum value of X1 (kpc)
ix1_bc    = outflow             # inner-X1 boundary flag (wake exits here)
ox1_bc    = user                # outer-X1 boundary flag (turbulent CGM inflow)

nx2       = 128                 # Number of zones in X2-direction
x2min     = -2.0                # minimum value of X2
x2max     = 2.0                 # maximum value of X2
ix2_bc    = outflow             # inner-X2 boundary flag
ox2_bc    = outflow             # outer-X2 boundary flag

nx3       = 128                 # Number of zones in X3-direction
x3min     = -2.0                # minimum value of X3
x3max     = 2.0                 # maximum value of X3
ix3_bc    = outflow             # inner-X3 boundary flag
ox3_bc    = outflow             # outer-X3 boundary flag

<meshblock>
nx1       = 256                 # Number of cells in each MeshBlock, X1-dir
nx2       = 128                 # Number of cells in each MeshBlock, X2-dir
nx3       = 128                 # Number of cells in each MeshBlock, X3-dir

<time>
evolution  = dynamic            # dynamic/kinematic/static
integrator = rk2                # time integration algorithm
cfl_number = 0.3                # The Courant, Friedrichs, & Lewy (CFL) Number
nlim       = -1                 # cycle limit
tlim       = 60.0               # time limit (code time = 0.978 Myr)
ndiag      = 100                # cycles between diagnostic output (reports cool_nsub)

<hydro>
eos         = ideal             # EOS type
reconstruct = plm               # spatial reconstruction method
rsolver     = hllc              # Riemann-solver to be used
nscalars    = 1                 # scalar 0 = wind mass fraction
gamma       = 1.6666667         # gamma = C_p/C_v
fofc        = true
tfloor      = 1.3857e-4         # T floor = 1e4 K (T_unit = mu*amu*(1000 km/s)^2/k_B = 7.216e7 K for mu = 0.6)

<hydro_srcterms>
ism_cooling         = true
cool_table          = true      # tabulated float Lambda(T) (false = analytic ISMCoolFn)
hrate               = 0.0       # no heating
cooling_subcycle    = true      # operator-split cooling, sub-cycled after the hydro step
cool_cfl            = 0.1       # each cooling sub-step <= cool_cfl * t_cool_min
cool_nsub_max       = 1000      # max sub-steps per hydro step; also caps dt
cool_mask_scalar    = 0         # no cooling where wind tracer (scalar 0) is below threshold
cool_mask_threshold = 1.0e-3    # wind mass fraction; below this the cell is pure CGM

<units>
length_cgs  = 3.086e+21         # 1 kpc  'L0'
mass_cgs    = 4.907e+40         # 1 (kpc^3)*(1mp/cm^3)   'L0^3*rho0'
time_cgs    = 3.086e+13         # 0.978 Myr; v0 = 1000 km/s
mu          = 0.6               # mean molecular weight (Idefix [Cooling] mu)

<problem>
user_srcs   = true              # BH gravity + wind injection
M_bh        = 2.0e7             # Msun
v_bh        = 1.0               # code units (1000 km/s)
epsilon     = 1.0e-2            # kpc, gravitational softening
n_cgm0      = 1.0               # cm^-3, CGM density at t = 0
dt_ncgm     = 8.0               # n_cgm(t) = n_cgm0*exp(-t/dt_ncgm)
T_cgm       = 1.0e6             # K
Mdot0       = 0.5               # Msun/yr, wind mass-loss rate at t = 0
dt_mdot     = 15.0              # Mdot(t) = Mdot0*exp(-t/dt_mdot)
vw0         = 0.1               # code units (100 km/s), constant wind speed
r_inj       = 0.1               # kpc, injection radius (3.2 cells)

# Turbulence: frozen solenoidal plane waves, advected in with the CGM at -v_bh
sigv        = 30.0              # km/s, 3D rms turbulent velocity
turb_lmin   = 0.125             # kpc, smallest wavelength (4 cells)
turb_lmax   = 2.0               # kpc, largest wavelength (half the box width)
turb_nmodes = 1024              # number of plane waves (log-spaced |k|)
turb_seed   = 1234

<output1>
file_type   = hst               # History data dump
dt          = 0.1               # time increment between outputs

<output2>
file_type   = bin               # Binary data dump
variable    = hydro_w           # variables to be output
dt          = 1.0               # time increment between outputs

<output3>
file_type   = rst               # Restart file
dt          = 10.0
