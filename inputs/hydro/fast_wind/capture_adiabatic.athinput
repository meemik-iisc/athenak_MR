# AthenaK input for the energy-driven counterpart of capture_cool: a 0.1c AGN wind whose
# shocked gas is NOT artificially cooled (no wind_cool; normal ism_cooling only), BH at
# 1000 km/s through a uniform n = 1, 1e6 K CGM, with the luminosity 100x below capture_cool.

<comment>
problem   = Fast adiabatic (energy-driven) wind, v_bh = 1000 km/s: how far does the hot
            shocked wind inflate the head, and how much ambient gas does it halt?
build     = ./make_build_single.sh fast_wind   (single precision; see T_w below)

# n = 1, pdot_AGN = 3.5e31 dyn (capture_cool / 100; L = pdot c = 1.0e42 erg/s).
#   Fast wind v_w = 0.1c -> Mdot = pdot/v_w = 1.84e-4 Msun/yr, L_kin = pdot v_w/2 = 5.2e40 erg/s
#   R_0 = sqrt(pdot / 4pi(rho v_bh^2 + P)) = 5.4 pc (momentum stand-off, lower bound)
#   Energy-driven bound: a Weaver bubble slows to v_bh at R ~ 17 pc after ~10 kyr
#   Mach(v_bh) = 6.6; shocked CGM ~1.4e7 K, t_cool ~ 1.7 Myr >> flow time R/v_bh ~ 5-17 kyr
#   Shocked wind ~1.2e10 K, n ~ 4.5e-3, c_s ~ 1.7e4 km/s; t_IC ~ 100 Myr, free-free ~ Gyr
#   -> effectively adiabatic; ism_cooling (with the capture_cool heating) is kept so
#   that dense mixed or compressed gas can still radiate.
#   Capture: momentum-only pdot/(v_bh + 200 km/s) ~ 4.6e-3 Msun/yr; energy bound
#   2 eps L_kin / v_bh^2 ~ 0.03 Msun/yr for eps ~ 0.2.
#   Mesh, r_inj and tlim are those of capture_cool (finest dx = 1.95 pc, r_inj = 10 pc)
#   for a like-for-like comparison. NOTE: R_0 = 5.4 pc is 2.8 cells and lies INSIDE
#   r_inj, so the reset sphere sits outside the termination shock and the head acts as a
#   ~10 pc obstacle with a wind, not a resolved wind bow shock.
#   dt ~ 0.3 * 1.95 pc / 3e4 km/s ~ 19 yr; tlim = 2000 (1.96 Myr) -> ~1e5 cycles.

<job>
basename  = capture_adiabatic

# BH frame: BH at the origin, CGM flows in through the outer-x1 face at -v_bh.
# 2000 x 1000 x 1000 pc with SMR (380 MeshBlocks of 32^3, 12.5M cells, ~7.8 GB in single):
#   level 0  dx = 7.81 pc  whole box                                   108 blocks
#   level 1  dx = 3.91 pc  x in [-1000, 250], y,z in [-250, 250]       144 blocks
#   level 2  dx = 1.95 pc  x in [-375, 125],  y,z in [-125, 125]       128 blocks
#            (here R_0 = 2.8 cells < r_inj = 5 cells; contains r_diag)
# Refined regions snap outward to the parent level's blocks (root 250 pc, level 1
# 125 pc, edges at x = -1500 + n*size, y,z = -500 + n*size), so keep their edges on
# those lines. Keep refinement away from the user (inflow) face at x = 500.
<mesh>
nghost    = 4
nx1       = 256
x1min     = -1500.0             # pc, wake
x1max     = 500.0               # pc, upstream (~9 R_0)
ix1_bc    = outflow
ox1_bc    = user                # uniform CGM inflow (+ impact-parameter tracer)

nx2       = 128
x2min     = -500.0              # pc
x2max     = 500.0
ix2_bc    = outflow
ox2_bc    = outflow

nx3       = 128
x3min     = -500.0
x3max     = 500.0
ix3_bc    = outflow
ox3_bc    = outflow

<meshblock>
nx1       = 32
nx2       = 32
nx3       = 32

<mesh_refinement>
refinement         = static
prolong_primitives = true

<refined_region1>
level     = 1
x1min     = -1000.0
x1max     = 250.0
x2min     = -250.0
x2max     = 250.0
x3min     = -250.0
x3max     = 250.0

<refined_region2>
level     = 2
x1min     = -375.0
x1max     = 125.0
x2min     = -125.0
x2max     = 125.0
x3min     = -125.0
x3max     = 125.0

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.3
nlim       = -1
tlim       = 2000.0             # code time = 977.8 yr -> 1.96 Myr (2000 pc at 1000 km/s)
ndiag      = 200

<hydro>
eos         = ideal
reconstruct = plm
rsolver     = hllc
nscalars    = 2                 # s_00 = wind fraction, s_01 = impact parameter b [pc]
gamma       = 1.6666667
fofc        = true
tfloor      = 1.3857e-4         # 1e4 K (T_unit = 7.216e7 K for mu = 0.6)

<hydro_srcterms>
ism_cooling      = true         # radiative cooling of CGM and wind gas (no cooling mask)
cool_table       = true
cooling_subcycle = true         # keeps any dense cooled gas from crushing the hydro dt
cool_cfl         = 0.1
cool_nsub_max    = 1000
hrate            = 0.0          # must be 0 (problem/heat_balance sets the heating)

<units>
length_cgs  = 3.086e+18         # 1 pc
mass_cgs    = 4.907e+31         # 1 pc^3 * 1 mp/cm^3
time_cgs    = 3.086e+10         # 977.8 yr; v0 = 1000 km/s
mu          = 0.6

<problem>
user_srcs   = true              # gravity + wind reset (wind_cool off)
user_hist   = true              # M_halt, Mdot_up, M_halt(b) in the .user.hst file
M_bh        = 2.0e7             # Msun (R_Bondi = GM/v_bh^2 = 0.09 pc, unresolved)
epsilon     = 1.0               # pc
v_bh        = 1000.0            # km/s
n_cgm       = 1.0               # cm^-3 (rho = 0.6 m_p n)
T_cgm       = 1.0e6             # K
Mdot        = 1.842e-4          # Msun/yr  (Mdot v_w = 3.5e31 dyn)
v_w         = 29979.0           # km/s (0.1 c)
T_w         = 1.0e7             # K; keeps E_kin/E_th of the free wind ~1e3-1e4 so single
                                # precision holds its pressure (at 1e4 K it is ~1e6); the
                                # wind thermal pressure at the termination shock is still
                                # ~1e-4 of its ram pressure
r_inj       = 10.0              # pc, as capture_cool; R_0/r_inj = 0.54 (unresolved, see top)
wind_cool   = false             # energy-driven: shocked wind keeps its heat
heat_balance = true             # heating n_cgm Lambda(T) per particle: net cooling n(n-n_cgm)Lambda
T_heat_max  = 3.0e6             # K; no heating above (shocked gas cools at n^2 Lambda)
heat_n_min  = 2.0               # below T_heat_max, n <= 2 n_cgm neither cools nor heats
                                # (stops the grid-scale thermal instability; also leaves the
                                # adiabatically expanded free wind alone)
r_diag      = 20.0              # pc (~ energy-driven scale; default 2 R_0 = 11 pc)

<output1>
file_type   = hst
dt          = 1.0               # ~1 kyr

<output2>
file_type   = bin
variable    = hydro_w           # incl. s_00 (wind) and s_01 (impact parameter)
dt          = 40.0              # ~39 kyr, 51 dumps (~0.35 GB each in single)

<output3>
file_type   = rst
dt          = 100.0
